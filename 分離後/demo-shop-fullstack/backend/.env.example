# ============================================
# demo-shop-backend .env.example（請複製為 .env 後再修改）
# 說明：此檔僅示意用，請替換為專案實際需求與安全值
# ============================================

# 服務與環境
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS 白名單（以逗號分隔，多個來源）
# 例：本機靜態前端與後端皆允許
HOST=127.0.0.1
CORS_WHITELIST=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3456,http://127.0.0.1:3456,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# 錯誤處理與稽核
# 是否啟用稽核日誌（請求/回應、遮罩敏感資料）
AUDIT_ENABLED=true
# 是否在錯誤回應中暴露 stack（建議 production 關閉）
ERROR_EXPOSE_STACK=true

# JWT 與會話
JWT_SECRET=change-me-super-secret-jwt
# JWT 過期時間（例如：1d、12h、3600s）
JWT_EXPIRES_IN=1d

# 管理者萬用密碼（僅供開發/測試，正式環境請關閉或改為強度高的值）
ADMIN_MASTER_PASSWORD=change-me-admin888

# 簽章 SignKey（前後端 HMAC-SHA256）
SIGNKEY_ENABLED=true
# 簽章雜湊演算法（目前僅示意，程式使用 HMAC-SHA256）
SIGNKEY_ALGO=HMAC-SHA256
# 簽章有效時間窗（毫秒），例：5 分鐘 = 300000
SIGNKEY_WINDOW_MS=300000
# 允許的時鐘偏移（毫秒），避免前後端時間微小誤差
SIGNKEY_CLOCK_SKEW_MS=10000
# Nonce 存活時間（毫秒），例：10 分鐘 = 600000
NONCE_TTL_MS=600000
# 每次登入下發的 session signKey 存活時間（毫秒）
SIGNKEY_SESSION_TTL_MS=3600000
# 簽章使用的 HTTP Header 名稱（可依需求調整）
SIGNKEY_HEADER_TIMESTAMP=X-Sign-Timestamp
SIGNKEY_HEADER_NONCE=X-Sign-Nonce
SIGNKEY_HEADER_SIGNATURE=X-Signature
SIGNKEY_HEADER_KEYID=X-Sign-KeyId
# 豁免簽章驗證的路由（以逗號分隔）
SIGNKEY_WHITELIST_PATHS=/api/v1/public/settings,/api/v1/auth/login,/api/v1/auth/register,/api/v1/products,/api/v1/pricing/quote

# 模組開關（mock/第三方）
MOCK_PAYMENT_ENABLED=true
MOCK_SMS_ENABLED=true

# 安全與速率限制（可選）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# 站台公開設定（會回傳於 /api/v1/public/settings；不含任何機敏值）
SITE_NAME=海螺小舖
CURRENCY=TWD
TAX_RATE=0.05
SHIPPING_FEE=80
FREE_SHIPPING_THRESHOLD=1500
VIP_DISCOUNT=0.9

# 資料儲存（seed/mock）
# file：以檔案 JSON 儲存；memory：記憶體（重啟即遺失）
DATA_STORE=file
# 當 DATA_STORE=file 時使用的資料目錄
DATA_DIR=./data
# 啟動時是否自動載入 seed（development 建議 true）
SEED_ON_START=true
# 僅在 development 可用的重置功能開關（/api/v1/admin/reset）
ALLOW_DEV_RESET=true

# 金流/簡訊金鑰（僅後端使用；請勿放在前端）
PAYMENT_SECRET_KEY=change-me-payment
SMS_API_KEY=change-me-sms

# 匯出設定
CSV_WITH_BOM=true